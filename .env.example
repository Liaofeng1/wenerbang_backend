PORT=8080
APP_ENV=dev
JWT_SECRET=dev-secret-change-in-production
DATABASE_DSN=file:wenbang.db?cache=shared&mode=rwc
REGISTER_BONUS=30
INVITE_REWARD=50
# §3.2.2 publish sunk cost
PUBLISH_COST=150
MIN_AWAY_SECONDS=120
PIN_HOURLY_COST=30
BOUNTY_MIN_COUNT=50
BOUNTY_MIN_PER=10
TARGETING_COST_PER_USER=5
TARGETING_DELIVERY_MULT=2

# Email verification (SMTP)
# If SMTP_HOST is empty, dev mode: print code to console
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASS=your-smtp-password
# SMTP_FROM=noreply@example.com
# EMAIL_VERIFICATION_EXPIRE=30