PORT=8080
APP_ENV=dev
JWT_SECRET=dev-secret-change-in-production
DATABASE_DSN=file:wenbang.db?cache=shared&mode=rwc
REGISTER_BONUS=150
INVITE_REWARD=50
PUBLISH_COST=150
MIN_AWAY_SECONDS=120
PIN_HOURLY_COST=30
BOUNTY_MIN_COUNT=50
BOUNTY_MIN_PER=10
TARGETING_COST_PER_USER=5
TARGETING_DELIVERY_MULT=2

# Email verification (SMTP)
# 留空则使用开发模式（验证码打印到终端控制台）
# 配置示例（163邮箱）：
#   SMTP_HOST=smtp.163.com
#   SMTP_PORT=25
#   SMTP_USER=your-email@163.com
#   SMTP_PASS=your-smtp-authorization-code
#   SMTP_FROM=your-email@163.com
SMTP_HOST=
SMTP_PORT=25
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
EMAIL_VERIFICATION_EXPIRE=30